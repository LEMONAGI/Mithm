    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 월경 주기와 가임기 일정을 캘린더에 표시하여 더 편리하게 일정 관리할 수 있도록 캘린더 접근 권한이 필요합니다."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월경 주기 분석과 배란 패턴 추적을 위해 건강 앱의 월경 관련 데이터를 읽어옵니다. 데이터는 주기 예측과 일정 표시 목적에만 사용되며 외부로 전송되지 않습니다."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자가 앱에서 기록한 월경 정보를 건강 앱에도 함께 저장하여 한 곳에서 주기 기록을 관리할 수 있도록 도와줍니다. 사용자가 입력한 실제 기록만 저장되며, 예측 정보는 저장하지 않습니다."
          }
        }
      }
    }
  },
  "version" : "1.0"
}