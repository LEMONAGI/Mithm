    "불명확" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unspecified"
          }
        }
      }
    },
    "불안감이나 예민함이 줄어들어 마음이 한결 편안해져요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anxiety or sensitivity may ease, helping your mind feel more comfortable."
          }
        }
      }
    },
    "불안하거나 이유 없이 울고 싶은 날이 있을 수 있어요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There may be days when you feel anxious or tearful for no clear reason"
          }
        }
      }
    },
    "사교적이고 외향적인 에너지가 올라와요" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your social energy may rise"
          }
        }
      }
    },
    "사람들과 소통하거나 내 의견을 표현하는 데 부담이 적고 편안함을 느껴요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Communicating with others or sharing your opinions may feel less burdensome and more comfortable."
          }
        }
      }
    },
    "사람들을 만나거나 협업하는 일이 평소보다 자연스럽게 느껴질 거예요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeting people or collaborating may feel more natural than usual."
          }
        }
      }
    },
    "사용자 기록에 기반한 실제 월경 기간입니다." : {
