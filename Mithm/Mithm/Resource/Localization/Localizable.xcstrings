          }
        }
      }
    },
    "가슴이 예민하거나 팽팽한 느낌": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breasts may feel tender or swollen"
          }
        }
      }
    },
    "감정 기복이 생기고 예민해지기 쉬워요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mood shifts and sensitivity may be more likely"
          }
        }
      }
    },
    "감정이 예민한 날엔 중요한 결정이나 감정이 오가는 대화를 미루는 것도 현명한 선택이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On emotionally sensitive days, it can be wise to postpone major decisions or emotionally heavy conversations."
          }
        }
      }
    },
    "감정이 예민한 날이라는 걸 스스로 알고 있으면, 그 감정에 덜 휘둘릴 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you know it may be an emotionally sensitive day, it can be easier to not get swept up in those feelings."
          }
        }
      }
    },
    "감정이 조금 더 예민하게 느껴져요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emotions may feel a little more sensitive"
          }
        }
      }
    },
    "개인정보 처리방침": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 처리방침"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy Policy"
          }
        }
      }
    },
    "건강 데이터 처리에 실패했어요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 데이터 처리에 실패했어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not process health data"
          }
        }
      }
    },
    "건강 데이터를 불러오지 못했어요.\n잠시 후 다시 시도해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 데이터를 불러오지 못했어요.\n잠시 후 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load health data.\nPlease try again in a moment."
          }
        }
      }
    },
    "건강 데이터를 삭제하지 못했어요.\n잠시 후 다시 시도해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 데이터를 삭제하지 못했어요.\n잠시 후 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not delete health data.\nPlease try again in a moment."
          }
        }
      }
    },
    "건강 데이터를 저장하지 못했어요.\n잠시 후 다시 시도해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 데이터를 저장하지 못했어요.\n잠시 후 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save health data.\nPlease try again in a moment."
          }
        }
      }
    },
    "건강 앱 권한을 확인하거나 잠시 후 다시 시도해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your Health app permissions or try again in a moment."
          }
        }
      }
    },
    "건강 앱 권한이 필요해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health app permission is needed"
          }
        }
      }
    },
    "건강 앱 접근 권한을 허용해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱 접근 권한을 허용해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please allow access to the Health app."
          }
        }
      }
    },
    "건강 앱 접근 권한이 필요해요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱 접근 권한이 필요해요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health app access is needed"
          }
        }
      }
    },
    "건강 앱에서 월경 기록을 추가하거나,\n설정 > 개인정보 보호 > 건강에서\nMithm의 접근 권한을 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱에서 월경 기록을 추가하거나,\n설정 > 개인정보 보호 > 건강에서\nMithm의 접근 권한을 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a period record in the Health app, or check Mithm's access in\nSettings > Privacy > Health."
          }
        }
      }
    },
    "건강 앱을 사용할 수 없어요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱을 사용할 수 없어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health app is unavailable"
          }
        }
      }
    },
    "건강앱과 연동하기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강앱과 연동하기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the Health app"
          }
        }
      }
    },
    "건강앱의 월경 기록을\n미리듬이 가져올 수 있게 허용해 주세요.\n몸의 기록은 안전하게 다룰게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강앱의 월경 기록을\n미리듬이 가져올 수 있게 허용해 주세요.\n몸의 기록은 안전하게 다룰게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Mithm to read your period records\nfrom the Health app.\nYour body data will be handled with care."
          }
        }
      }
    },
    "격한 운동보다 요가, 필라테스, 가벼운 걷기처럼 몸을 이완하는 활동이 증상 완화에 효과적이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle movement like yoga, Pilates, or light walking may help ease symptoms more than intense exercise."
          }
        }
      }
    },
    "격한 운동보다는 가벼운 산책이나 스트레칭이 오히려 통증 완화에 도움이 돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A light walk or gentle stretching may help ease discomfort more than intense exercise."
          }
        }
      }
    },
    "결단력이 있고 행동으로 옮기기 쉬운 시기예요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may feel easier to decide and take action"
          }
        }
      }
    },
