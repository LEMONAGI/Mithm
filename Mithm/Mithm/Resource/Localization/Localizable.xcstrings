      }
    },
    "저장": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        }
      }
    },
    "저장에 실패했어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save"
          }
        }
      }
    },
    "전반적으로 컨디션이 좋고, 몸이 잘 움직이는 느낌이에요. 일부는 아랫배 한쪽이 살짝 당기는 느낌을 경험하기도 하는데, 배란 통증이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may generally feel well and physically capable. Some people may feel a slight pulling sensation on one side of the lower belly, which can be ovulation pain."
          }
        }
      }
    },
    "종료일": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End Date"
          }
        }
      }
    },
    "주기 시작": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycle Start"
          }
        }
      }
    },
    "중간": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medium"
          }
        }
      }
    },
    "중요한 결정이나 무거운 대화는 가능하면 며칠 뒤로 미뤄보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If possible, consider postponing major decisions or heavy conversations for a few days."
          }
        }
      }
    },
    "지금 내보내기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 내보내기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Now"
          }
        }
      }
    },
    "지금은 몸이 스스로 리셋하는 시기예요. 억지로 평소 페이스를 유지하려 하기보다, 조금 느슨하게 가는 것이 오히려 다음 주기를 잘 시작하는 방법이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a time when your body is resetting itself. Instead of forcing your usual pace, giving yourself a little room may help you begin the next cycle well."
          }
        }
      }
    },
    "지원": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support"
          }
        }
      }
    },
    "직접 입력값": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 입력값"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual Inputs"
          }
        }
      }
    },
    "직접 입력한 주기와 기간만 사용해 예측해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 입력한 주기와 기간만 사용해 예측해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Predict using only the cycle and period length you entered."
          }
        }
      }
    },
    "집중력과 기억력이 좋아지는 편이에요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus and memory may feel stronger"
          }
        }
      }
    },
    "집중력이 평소보다 떨어질 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus may be lower than usual"
          }
        }
      }
    },
    "집중력이 흐트러지거나 멍해지는 느낌이 들 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may feel unfocused or foggy"
          }
        }
      }
    },
    "체력과 지구력이 한 주기 중 가장 높은 편": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength and stamina may be among the highest in your cycle"
          }
        }
      }
    },
    "체력과 회복력이 올라가는 시기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength and recovery may improve"
          }
        }
      }
    },
    "체온이 낮고 손발이 차가울 수 있음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body temperature may be lower, and hands or feet may feel cold"
          }
        }
      }
    },
    "체온이 살짝 오르는 시기 (배란 후 더 오름)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body temperature may rise slightly, and more after ovulation"
          }
        }
      }
    },
    "체온이 전 주기보다 높은 편": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body temperature may be higher than earlier in the cycle"
          }
        }
      }
    },
    "총 레코드 수: %lld": {
      "localizations": {
        "en": {
