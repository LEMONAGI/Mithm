    },
    "이번 월경을 기록하였습니다": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 월경을 기록하였습니다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This period has been recorded."
          }
        }
      }
    },
    "이전 월경 종료를 자동으로 기록했습니다!": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 월경 종료를 자동으로 기록했습니다!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your previous period end was recorded automatically."
          }
        }
      }
    },
    "일정이 꽉 차 있다면 중간에 짧은 휴식을 의식적으로 끼워 넣어보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your schedule is packed, try intentionally adding short breaks between plans."
          }
        }
      }
    },
    "자신감과 표현력이 좋아지는 편이에요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidence and expression may feel stronger"
          }
        }
      }
    },
    "잘 모르겠어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm not sure"
          }
        }
      }
    },
    "잠금 해제 후 잠시 뒤 다시 시도해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock your device, then try again in a moment."
          }
        }
      }
    },
    "잠시 후 다시 시도해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 후 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please try again in a moment."
          }
