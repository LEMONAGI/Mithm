          "stringUnit": {
            "state": "translated",
            "value": "기록 데이터"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded Data"
          }
        }
      }
    },
    "기록 데이터를 바탕으로 주기를 예측해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 데이터를 바탕으로 주기를 예측해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Predict your cycle based on recorded data."
          }
        }
      }
    },
    "기록 데이터와 직접 입력값을 함께 반영해 예측해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 데이터와 직접 입력값을 함께 반영해 예측해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use both recorded data and your manual inputs for predictions."
          }
        }
      }
    },
    "기록 저장 후 조회 + 캘린더": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Record, Then Fetch + Calendar"
          }
        }
      }
    },
    "기분이 안정되고 긍정적인 감정이 올라와요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your mood may feel steadier and more positive"
          }
        }
      }
    },
    "나중에 하기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 하기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maybe Later"
          }
        }
      }
    },
    "난포기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "난포기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follicular Phase"
          }
        }
      }
    },
    "내일부터 난포기가 시작됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일부터 난포기가 시작됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your follicular phase is expected to start tomorrow."
          }
        }
      }
    },
    "년": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "년"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Year"
          }
        }
      }
    },
    "뇌하수체에서 분비된 FSH(난포자극극호르몬)가 난소의 난포를 성장시키고, 성장하는 난포에서 에스트로겐이 점점 많이 분비되기 시작해요. 에스트로겐은 도파민, 세로토닌과 상호작용하면서 기분을 높이고 집중력·사고력을 향상시켜요. 뇌 기능이 실제로 활발해지는 시기라, \"오늘 머리가 잘 돌아가네\" 싶은 날이 많아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FSH, or follicle-stimulating hormone, is released from the pituitary gland and helps ovarian follicles grow. As the follicles develop, they begin producing more estrogen. Estrogen interacts with dopamine and serotonin, which may support mood, focus, and clearer thinking. This is often a time when your mind may feel more alert."
          }
        }
      }
    },
    "다시 불러오기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        }
      }
    },
    "다시 조회 + 캘린더": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetch Again + Calendar"
          }
        }
      }
    },
    "다음 월경 예정일": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 월경 예정일"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next Expected Period"
          }
        }
      }
    },
    "다음으로": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음으로"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        }
      }
    },
    "단것이 당기는 건 혈당 변동 때문이에요. 초콜릿 한 조각 정도는 괜찮지만, 폭식보다는 마그네슘·철분이 든 음식이 도움이 돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Craving sweets may be related to blood sugar changes. A piece of chocolate is okay, but foods with magnesium and iron may be more helpful than overeating."
          }
        }
      }
    },
    "달력": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar"
          }
        }
      }
    },
    "당신만의 리듬 패턴을\n알려주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us about\nyour own rhythm pattern"
          }
        }
      }
    },
    "당신만의 리듬 패턴을\n알아갈게요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신만의 리듬 패턴을\n알아갈게요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's learn\nyour rhythm pattern"
          }
        }
      }
    },
    "당신의 리듬을 이해하는\n첫 단계예요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 리듬을 이해하는\n첫 단계예요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first step\nto understanding your rhythm"
          }
        }
      }
    },
    "당신의 리듬이\n일상에 연결될 수 있도록": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 리듬이\n일상에 연결될 수 있도록"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your rhythm\nto your everyday life"
          }
        }
      }
    },
    "더 정확한\n리듬을 이해하기 위해": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 정확한\n리듬을 이해하기 위해"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To understand\nyour rhythm more accurately"
          }
        }
      }
    },
    "더미 이벤트 추가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Dummy Event"
          }
        }
      }
    },
    "도전적인 일에 의욕이 생기는 시기예요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may feel more motivated to take on challenges"
          }
        }
      }
    },
    "둘 다 사용": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 사용"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Both"
          }
        }
      }
    },
    "따뜻한 음식, 충분한 수면, 핫팩 하나가 컨디션 차이를 만들어 줄 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm meals, enough sleep, and a heat pack can make a noticeable difference in how you feel."
          }
        }
      }
    },
    "레코드": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records"
          }
        }
      }
    },
    "마지막 동기화:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last Sync:"
          }
        }
      }
    },
    "마지막 동기화: %@ %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "마지막 동기화: %1$@ %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last Sync: %1$@ %2$@"
          }
        }
      }
    },
    "마지막 로드: %@ %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "마지막 로드: %1$@ %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last Loaded: %1$@ %2$@"
          }
        }
      }
    },
    "마지막 월경 날짜는 언제인가요?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 월경 날짜는 언제인가요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When was your last period?"
          }
        }
      }
    },
    "마지막 캘린더 내보내기: %@ %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "마지막 캘린더 내보내기: %1$@ %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last Calendar Export: %1$@ %2$@"
          }
        }
      }
    },
    "많음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heavy"
          }
        }
      }
    },
    "머리가 맑고 뭔가 해보고 싶은 마음이 슬슬 생기는 시기예요. 새로운 걸 시작하거나 사람들을 만나는 게 부담스럽지 않고, 오히려 에너지가 느껴져요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your mind may feel clearer, and you may slowly feel more ready to try things. Starting something new or meeting people may feel less burdensome and more energizing."
          }
        }
      }
    },
    "모든 앱 이벤트 삭제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete All App Events"
          }
        }
      }
    },
    "몸과 뇌가 함께 깨어나는 시기예요. 미뤄뒀던 일을 꺼내기에 좋고, 새로운 루틴을 시작하기에도 가장 수월한 타이밍이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a time when your body and mind may feel more awake. It can be a good time to return to postponed tasks or start a new routine with less friction."
          }
        }
      }
    },
    "몸과 마음이 가장 잘 맞아 돌아가는 시기예요. 중요한 일, 사람을 만나는 일, 목소리를 내야 하는 일들을 이 시기에 배치하면 훨씬 수월하게 느껴질 거예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This may be a time when your body and mind feel especially in sync. Important tasks, meetings, or moments when you need to speak up may feel easier here."
          }
        }
      }
    },
    "몸이 붓고 무거운 느낌": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body may feel swollen or heavy"
          }
        }
      }
    },
    "몸이 전반적으로 무겁게 느껴짐": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body may feel generally heavy"
          }
        }
      }
    },
    "몸이 조금씩 가벼워지고, 피부가 맑아지는 느낌이 드는 시기예요. 월경이 끝나고 나서 \"오늘은 좀 살 것 같다\" 싶은 날들이 바로 난포기예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a time when your body may start to feel lighter and your skin may feel clearer. Those days after your period when you start to feel like yourself again often fall in the follicular phase."
          }
        }
      }
    },
    "몸이 조금씩 무거워지고, 붓거나 예민해지는 느낌이 드는 시기예요. 배란 이후 시간이 지날수록 증상이 강해지는 경우가 많고, 이건 매우 흔한 일이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a time when your body may start to feel heavier, swollen, or more sensitive. Symptoms often become stronger as time passes after ovulation, and that is very common."
          }
        }
      }
    },
    "calendar.title": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리듬"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirythm"
          }
        }
      }
    },
    "미듬": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미듬"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mithm"
          }
        }
      }
    },
    "미리듬": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mithm"
          }
        }
      }
    },
    "미리듬 앱에서 생성하지 않은 월경 기록은 수정할 수 없어요.\n건강 앱에서 직접 수정해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Period records not created by Mithm cannot be edited here.\nPlease edit them directly in the Health app."
          }
        }
      }
    },
    "미리듬은 배란기와 가임기를 동일한 시기로 안내합니다. 실제 가임 시기는 개인에 따라 달라질 수 있으므로, 이를 피임의 수단으로 사용하지 마십시오.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mithm shows ovulation and the fertile window as the same period. The actual fertile window can vary by person, so do not use this as a method of contraception."
          }
        }
      }
    },
    "발표, 면접, 중요한 미팅처럼 인상을 남겨야 하는 자리에 잘 맞는 시기예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This may be a good time for moments where you want to make an impression, such as presentations, interviews, or important meetings."
          }
        }
      }
    },
    "배란 직후 - 월경 시작 직전": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right after ovulation - just before your period starts"
          }
        }
      }
    },
    "배란 후 황체에서 프로게스테론이 분비되기 시작해요. 프로게스테론은 자궁 내막을 안정시키는 역할을 하지만, 동시에 세로토닌 수치를 낮추고 GABA 수용체에 영향을 미쳐 기분 변화·불안·피로감을 유발할 수 있어요. 월경이 가까워질수록 에스트로겐과 프로게스테론이 모두 떨어지면서 PMS 증상이 나타나기 쉬운 구간이 돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After ovulation, the corpus luteum begins releasing progesterone. Progesterone helps stabilize the uterine lining, but it can also affect serotonin levels and GABA receptors, which may contribute to mood changes, anxiety, or fatigue. As your period approaches, both estrogen and progesterone drop, making PMS symptoms more likely."
          }
        }
      }
    },
    "배란기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배란기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovulation Phase"
          }
        }
      }
    },
