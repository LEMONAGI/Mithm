    "캘린더 확인/생성": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check/Create Calendar"
          }
        }
      }
    },
    "캘린더로 내보내기": {
      "extractionState": "manual",
