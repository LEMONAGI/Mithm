          }
        }
      }
    },
    "일정이 꽉 차 있다면 중간에 짧은 휴식을 의식적으로 끼워 넣어보세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your schedule is packed, try intentionally adding short breaks between plans."
          }
        }
      }
    },
    "자신감과 표현력이 좋아지는 편이에요" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You may feel more confident and expressive"
          }
        }
      }
    },
    "잘 모르겠어요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'm not sure"
          }
        }
      }
    },
    "잠금 해제 후 잠시 뒤 다시 시도해 주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
