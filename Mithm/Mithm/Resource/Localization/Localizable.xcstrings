    "복부·허리의 묵직한 통증": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dull heaviness in the lower belly or back"
          }
        }
      }
    },
    "불명확": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unspecified"
          }
        }
      }
    },
    "불안하거나 이유 없이 울고 싶은 날이 있을 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There may be days when you feel anxious or tearful for no clear reason"
          }
        }
      }
    },
    "사교적이고 외향적인 에너지가 올라와요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Social and outward-facing energy may rise"
          }
        }
      }
    },
    "사람들을 만나거나 협업하는 일이 평소보다 자연스럽게 느껴질 거예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting people or collaborating may feel more natural than usual."
          }
        }
      }
    },
    "사용자 기록에 기반한 실제 월경 기간입니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 기록에 기반한 실제 월경 기간입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an actual period window based on your records."
          }
        }
      }
    },
    "삭제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "삭제하기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "삭제한 기록은 건강 앱에서도 지워집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted records will also be removed from the Health app."
          }
        }
      }
    },
    "새로고침": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        }
      }
    },
    "새로운 걸 시작하기보다 이미 진행 중인 일을 마무리하는 데 집중해보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead of starting something new, try focusing on finishing what is already in progress."
          }
        }
      }
    },
    "새로운 프로젝트나 공부를 시작하기 좋은 시기예요. 이 에너지가 있을 때 첫 발을 떼보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This may be a good time to start a new project or study plan. Use this energy to take the first step."
          }
        }
      }
    },
    "선택 완료": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 완료"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "설정": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "설정 > 개인정보 보호 > 건강에서\nMithm의 접근 권한을 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 > 개인정보 보호 > 건강에서\nMithm의 접근 권한을 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Mithm's access in\nSettings > Privacy > Health."
          }
        }
      }
    },
    "설정 > 개인정보 보호 > 캘린더에서\nMithm의 접근 권한을 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 > 개인정보 보호 > 캘린더에서\nMithm의 접근 권한을 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Mithm's access in\nSettings > Privacy > Calendars."
          }
        }
      }
    },
    "설정 > 개인정보 보호 및 보안 > 건강에서 활성화해 주세요. 권한을 허용해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 > 개인정보 보호 및 보안 > 건강에서 활성화해 주세요. 권한을 허용해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on in Settings > Privacy & Security > Health. Please allow permission."
          }
        }
      }
    },
    "설정으로 이동": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "손목온도 샘플 (HealthKit)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrist Temperature Samples (HealthKit)"
          }
        }
      }
    },
    "손목온도 샘플 수: %lld개": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrist temperature samples: %lld"
          }
        }
      }
    },
    "수정할 수 없는 기록이에요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This record can't be edited"
          }
        }
      }
    },
    "시작일": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Date"
          }
        }
      }
    },
    "식욕이 늘거나 특정 음식이 당김": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appetite may increase or specific cravings may appear"
          }
        }
      }
    },
    "식욕이 비교적 안정적": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appetite may feel relatively steady"
          }
        }
      }
    },
    "실제 월경 기록 저장": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Actual Period Record"
          }
        }
      }
    },
    "아랫배 한쪽이 잠깐 당기는 느낌이 들 수 있음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One side of the lower belly may briefly feel tight"
          }
        }
      }
    },
    "아랫배나 허리가 묵직하게 당기고, 평소보다 괜히 더 피곤한 느낌이 들 수 있어요. 몸이 무겁고 뭔가 하기 싫어지는 건 의지 문제가 아니라, 지금 몸이 꽤 많은 에너지를 쓰고 있기 때문이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your lower belly or back may feel dull and heavy, and you may feel more tired than usual. Feeling heavy or unmotivated is not a lack of willpower; your body may simply be using a lot of energy right now."
          }
        }
      }
    },
    "알 수 없는 오류가 발생했어요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 오류가 발생했어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unknown error occurred"
          }
        }
      }
    },
    "앞으로의 예측을\n당신에게 맞게 조율할게요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tune future predictions\nto fit you"
          }
        }
      }
    },
    "앱 전용 캘린더 이벤트 (%lld개)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Calendar Events (%lld)"
          }
        }
      }
    },
    "앱에서 예측한 배란일입니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 예측한 배란일입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an ovulation day predicted by the app."
          }
        }
      }
    },
    "앱에서 예측한 월경 예정 기간입니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 예측한 월경 예정 기간입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a period window predicted by the app."
          }
        }
      }
    },
    "앱이 건강 기록을 기반으로 사후적으로 추정한 배란일입니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 건강 기록을 기반으로 사후적으로 추정한 배란일입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an ovulation day retrospectively estimated by the app based on health records."
          }
        }
      }
    },
    "어려운 개념 정리, 복잡한 기획, 논리적 사고가 필요한 작업을 이 시기에 몰아두면 효율이 달라요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks that require organizing difficult concepts, complex planning, or logical thinking may feel more efficient during this phase."
          }
        }
      }
    },
    "에너지가 넘친다고 과하게 쓰기보다, 다음 황체기를 위해 조금 여유를 남겨두는 것도 좋아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even if you feel full of energy, it may help to leave a little margin for the luteal phase ahead."
          }
        }
      }
    },
    "에스트로겐과 프로게스테론이 동시에 낮아지면서 자궁 내막이 탈락하고 월경이 시작됩니다. 이 호르몬들은 세로토닌(기분 안정), 도파민(동기·의욕)과도 연결되어 있어서, 수치가 낮아지면 기분이 가라앉거나 무기력함이 느껴질 수 있어요. 몸은 지금 새로운 주기를 준비하기 위해 꽤 많은 에너지를 쓰고 있는 중이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As estrogen and progesterone both drop, the uterine lining sheds and your period begins. These hormones are connected with serotonin, which supports mood stability, and dopamine, which supports motivation. When their levels fall, your mood may feel lower or your energy may dip. Your body is using quite a bit of energy to prepare for a new cycle."
          }
        }
      }
    },
    "에스트로겐이 증가하며 에너지와 집중이 올라요\n전반적인 리듬이 부드럽게 올라와요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에스트로겐이 증가하며 에너지와 집중이 올라요\n전반적인 리듬이 부드럽게 올라와요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As estrogen rises, energy and focus may increase\nYour overall rhythm may gently lift"
          }
        }
      }
    },
    "에스트로겐이 최고조로 컨디션이 안정돼요\n몸의 리듬이 안정적으로 맞물려요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에스트로겐이 최고조로 컨디션이 안정돼요\n몸의 리듬이 안정적으로 맞물려요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As estrogen peaks, you may feel more steady\nYour body rhythm may feel well aligned"
          }
        }
      }
    },
    "에스트로겐이 최고조에 달하면 LH(황체형성호르몬)가 급격히 분비되면서 배란이 일어나요. 이 시기엔 테스토스테론도 소폭 상승해 활력과 자신감, 사교성이 높아지는 데 기여해요. 진화적으로 이 시기에 사회적 활동이 활발해지도록 설계되어 있다는 연구들도 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When estrogen reaches its peak, LH, or luteinizing hormone, rises sharply and ovulation occurs. Testosterone may also rise slightly during this time, which can contribute to energy, confidence, and sociability. Some research suggests social activity may naturally feel easier around this phase."
          }
        }
      }
    },
    "예민해지거나 이유 없이 우울한 기분이 드는 날이 생길 수 있어요. 집중이 잘 안 되거나 작은 일에 감정이 크게 반응하는 것도 이 시기엔 자연스러운 일이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There may be days when you feel more sensitive or low for no clear reason. It is also natural during this phase to have trouble focusing or to react more strongly to small things."
          }
        }
      }
    },
    "예측된 월경 예정일을 바탕으로 계산한 배란기(가임기)입니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측된 월경 예정일을 바탕으로 계산한 배란기(가임기)입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ovulation window, also shown as the fertile window, is calculated from the predicted period date."
          }
        }
      }
    },
    "오래 미뤄온 어려운 대화, 협상, 부탁—지금 하면 생각보다 잘 풀릴 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A difficult conversation, negotiation, or request you have been postponing may go more smoothly than expected now."
          }
        }
      }
    },
    "오류가 발생했어요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류가 발생했어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        }
      }
    },
    "외향적인 에너지가 올라오고, 사람들과 함께하는 게 즐겁게 느껴지는 시기예요. 자신감이 올라와 발표나 대화가 평소보다 자연스럽게 느껴질 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outward-facing energy may rise, and being with people may feel more enjoyable. Confidence can increase, so presenting or having conversations may feel more natural than usual."
          }
        }
      }
    },
    "운동 강도를 높이거나 체력 테스트를 해보고 싶다면 지금이 가장 좋아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you want to increase workout intensity or test your stamina, this may be a good time."
          }
        }
      }
    },
    "운동을 새로 시작하거나 강도를 높이고 싶다면 지금이 적기예요. 회복도 빠른 편이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you want to start exercising or increase intensity, this may be a good time. Recovery may also feel quicker."
          }
        }
      }
    },
