          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create calendar"
          }
        }
      }
    },
    "캘린더에 월경 기록을 내보내지 못했어요.\n잠시 후 다시 시도해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더에 월경 기록을 내보내지 못했어요.\n잠시 후 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not export period records to Calendar.\nPlease try again in a moment."
          }
        }
      }
    },
    "평소보다 쉽게 피로해지는 느낌": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may feel tired more easily than usual"
          }
        }
      }
    },
    "표시할 레코드가 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No records to show."
          }
        }
      }
    },
    "표시할 손목온도 기록이 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No wrist temperature records to show."
          }
        }
      }
    },
    "표시할 월경 기록이 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No period records to show."
          }
        }
      }
    },
    "표시할 이벤트가 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No events to show."
          }
        }
      }
    },
    "프로게스테론이 높아지며 몸이 회복을 준비해요\n리듬이 정리되며 몸이 쉬어갈 준비를 해요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로게스테론이 높아지며 몸이 회복을 준비해요\n리듬이 정리되며 몸이 쉬어갈 준비를 해요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As progesterone rises, your body prepares to recover\nYour rhythm settles as your body gets ready to rest"
          }
        }
      }
    },
    "피로가 줄고 몸이 가벼워지는 느낌": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatigue may ease and your body may feel lighter"
          }
        }
      }
    },
    "피부 광택이 좋고 전반적으로 컨디션이 좋음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skin may look brighter and you may feel generally well"
          }
        }
      }
    },
    "피부 컨디션이 좋아지기 시작함": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skin condition may start to improve"
          }
        }
      }
    },
    "피부가 조금 거칠어질 수 있음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skin may feel a little rougher"
          }
        }
      }
    },
    "해당 기간 삭제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete This Period"
          }
        }
      }
    },
    "호르몬이 낮아지며 몸이 휴식 모드로 바뀌어요\n몸이 리듬을 가다듬으며 쉬어가요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호르몬이 낮아지며 몸이 휴식 모드로 바뀌어요\n몸이 리듬을 가다듬으며 쉬어가요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As hormones drop, your body shifts into rest mode\nYour body slows down and resets its rhythm"
          }
        }
      }
    },
    "혼자 있고 싶거나, 쉬고 싶은 마음이 강해져요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may want more time alone or more rest"
          }
        }
      }
    },
    "혼자 조용히 있고 싶거나, 별것 아닌 일에 예민하게 반응하게 되는 날이에요. 집중이 잘 안 되고, 감정이 쉽게 출렁이는 것도 자연스러운 반응이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may want to be alone quietly, or you may react more sensitively to small things. Trouble focusing and more emotional ups and downs can be natural during this phase."
          }
        }
      }
    },
    "혼자만의 시간이 더 필요하게 느껴질 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may feel a stronger need for time alone"
          }
        }
      }
    },
    "홈": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        }
      }
    },
    "확인": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "황체기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "황체기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luteal Phase"
          }
        }
      }
    },
    "황체기 후반은 몸이 스스로 속도를 줄이려는 시기예요. 이 신호를 무시하고 무리하기보다, 조금 다른 방식으로 생산성을 유지하는 전략이 더 잘 맞아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The later luteal phase is a time when your body may naturally try to slow down. Instead of pushing through those signals, a different approach to productivity may fit better."
          }
        }
      }
    }
  },
  "version": "1.0"
}
