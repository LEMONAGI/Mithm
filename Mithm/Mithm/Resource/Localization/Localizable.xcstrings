          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete This Period"
          }
        }
      }
    },
    "호르몬의 영향으로 기분이 안정되고 긍정적인 감정이 올라와요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hormonal changes may help your mood feel steadier and bring more positive feelings."
